<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/form_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls"
    android:scrollbarStyle="outsideInset">

    <LinearLayout
        android:id="@+id/form_content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_l"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Árbol genealógico geográfico"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_m" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etName"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Relación"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spRelation"
            style="@style/Widget.App.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvColorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Color del marcador"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/spacing_m" />

        <Spinner
            android:id="@+id/spColor"
            style="@style/Widget.App.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Dirección completa"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAddress"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección completa"
            android:imeOptions="actionDone"
            android:inputType="textPostalAddress"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Añadir"
            android:contentDescription="Añadir dirección familiar" />

        <Button
            android:id="@+id/btnMyLocation"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="Mi ubicación" />

        <LinearLayout
            android:id="@+id/actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_m">

            <Button
                android:id="@+id/btnClearAll"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Borrar todo" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnRemoveLast"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Borrar último" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>

