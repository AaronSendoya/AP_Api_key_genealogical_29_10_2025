<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Define top-level Widget to avoid implicit parent resolution errors -->
    <style name="Widget" />
    <!-- Base namespace style to satisfy any merged references -->
    <style name="Widget.App" />
    <!-- Card container style -->
    <style name="Widget.App.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/spacing_l</item>
        <item name="android:elevation">@dimen/elevation_card</item>
    </style>

    <!-- Primary button -->
    <style name="Widget.App.Button.Primary" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/spacing_l</item>
        <item name="android:paddingRight">@dimen/spacing_l</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <!-- EditText style -->
    <style name="Widget.App.EditText" parent="android:Widget.EditText">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingLeft">@dimen/spacing_m</item>
        <item name="android:paddingRight">@dimen/spacing_m</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">#99333333</item>
    </style>

    <!-- Spinner style -->
    <style name="Widget.App.Spinner" parent="android:Widget.Spinner">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingLeft">@dimen/spacing_m</item>
        <item name="android:paddingRight">@dimen/spacing_m</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:popupBackground">@android:color/white</item>
    </style>
</resources>

